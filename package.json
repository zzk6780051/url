{
  "name": "url-shortener-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "基于 Cloudflare Workers + D1 的短链接服务",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "db:init:local": "wrangler d1 execute shortlinks --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute shortlinks --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
